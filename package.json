{
  "name": "jsonx",
  "version": "2.0.1",
  "description": "React JSON Syntax - Construct React elements, JSX and HTML with JSON without transpilers. JSONX supports React Function and Class Components, React Lazy and Suspense Components, and full support for React Hooks",
  "main": "dist/index.cjs",
  "module": "build/index.js",
  "esm": "dist/index.esm.js",
  "browser": "dist/index.web.js",
  "modules.root": "build",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.js -w",
    "benchmark": "node -r esm  benchmark/main_bmrk.js",
    "test": "jest --coverage",
    "lid:check": "node scripts/lid-check.mjs",
    "doc": "tsc && typedoc && sitedown manual/ -b docs/manual",
    "compile": "tsc",
    "esbuild": "node esbuild.config.js",
    "build": "tsc && node esbuild.config.js && typedoc && sitedown manual/ -b docs/manual",
    "coverage": "coveralls"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repetere/jsonx.git"
  },
  "keywords": [
    "jsx",
    "React",
    "server-side-react",
    "json jsx",
    "jamstack",
    "json",
    "jsonx",
    "reactive",
    "react-json",
    "react-json-schema",
    "json-react",
    "jsx-json"
  ],
  "author": {
    "name": "Yaw Joseph Etse",
    "email": "yaw@repetere.io"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/repetere/jsonx/issues"
  },
  "homepage": "https://github.com/repetere/jsonx#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@crokita/rollup-plugin-node-builtins": "^2.1.3",
    "@repetere/esdoc-inject-gtm-plugin": "0.1.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsdom-global": "3.0.7",
    "@types/luxon": "3.7.2",
    "@types/memory-cache": "0.2.6",
    "@types/numeral": "2.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-dom-factories": "1.0.5",
    "@types/supertest": "^7.2.0",
    "@types/ua-parser-js": "0.7.39",
    "benchmark": "2.1.4",
    "coveralls": "3.1.1",
    "esbuild": "^0.28.1",
    "esbuild-node-builtins": "^0.1.0",
    "esbuild-plugin-globals": "^0.2.0",
    "express": "^5.2.1",
    "husky": "9.1.7",
    "install": "0.13.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "29.1.1",
    "jsdom-global": "3.0.2",
    "lodash-es": "4.18.1",
    "microtime": "3.1.1",
    "prettier": "3.8.4",
    "puppeteer": "^25.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "routes": "2.1.0",
    "sitedown": "^5.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsd-jsdoc": "2.5.0",
    "tslib": "^2.8.1",
    "tslint-config-prettier": "1.18.0",
    "typedoc": "^0.28.19",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@hookform/error-message": "^2.0.1",
    "@types/prop-types": "^15.7.15",
    "create-react-class": "^15.7.0",
    "luxon": "3.7.2",
    "memory-cache": "0.2.0",
    "numeral": "2.0.6",
    "prop-types": "^15.8.1",
    "react-dom-factories": "1.0.2",
    "react-hook-form": "^7.80.0",
    "ua-parser-js": "^2.0.10"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "./src/jest_custom_test_env.ts",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "globals": {
      "ts-jest": {
        "extensionsToTreatAsEsm": [
          ".ts"
        ],
        "useESM": true,
        "diagnostics": false
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "prepare": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      {
        "path": "@semantic-release/git",
        "assets": [
          "package.json",
          "package-lock.json",
          "CHANGELOG.md"
        ],
        "message": "Release: ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "type": "docs",
              "scope": "README",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "major"
            },
            {
              "type": "style",
              "release": "patch"
            }
          ],
          "parserOpts": {
            "noteKeywords": [
              "BREAKING CHANGE",
              "BREAKING CHANGES"
            ]
          }
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/changelog"
    ]
  }
}
